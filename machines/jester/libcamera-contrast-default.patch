+/*
+ * OV2740 soft-ISP runs at high analog gain in typical lighting, which lifts
+ * the black floor and yields a washed-out, low-contrast ("milky") image.
+ * A contrast default > 1.0 applies an S-curve (contrastExp = tan(contrast*pi/4))
+ * that deepens shadows and restores apparent contrast, with no exposure, gain,
+ * or frame-rate cost. 1.0 is fully linear (no curve).
+ */
+constexpr float kDefaultContrast = 1.3f;
