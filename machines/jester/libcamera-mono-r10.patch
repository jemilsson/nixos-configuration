 /*
+ * 10-bit mono (Y10 / Y10P) is not Bayer data: there is nothing to
+ * interpolate, so each line is a straight copy to 8-bit grey. The
+ * unpacked variant drops the 2 least-significant bits; the CSI-2 packed
+ * variant keeps the 4 most-significant-bit bytes of every 5-byte group
+ * and skips the 5th byte holding the 4 x 2 least-significant bits, the
+ * same layout the debayer10P_* functions walk.
+ *
+ * green_ carries the gain + gamma lookup built by updateLookupTables()
+ * when no CCM is active; with a CCM the per-channel tables are unused
+ * and gammaLut_ is the only populated 8-bit lookup, so use that instead.
+ * A CCM is meaningless for mono input either way.
+ */
+#define STORE_MONO(value_)                             \
+	if constexpr (ccmEnabled)                      \
+		*dst++ = gammaLut_[value_];            \
+	else                                           \
+		*dst++ = green_[value_];
+
+template<bool addAlphaByte, bool ccmEnabled>
+void DebayerCpu::debayer10_MONO_R8(uint8_t *dst, const uint8_t *src[])
+{
+	const uint16_t *curr = (const uint16_t *)src[1];
+
+	for (unsigned int x = 0; x < window_.width; x++) {
+		/* shift by 2 for 10 -> 8 bpp value */
+		STORE_MONO(curr[x] >> 2)
+	}
+}
+
+template<bool addAlphaByte, bool ccmEnabled>
+void DebayerCpu::debayer10P_MONO_R8(uint8_t *dst, const uint8_t *src[])
+{
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+	const uint8_t *curr = src[1];
+
+	for (unsigned int x = 0; x < widthInBytes; x += 5) {
+		/* The 4 most-significant-bit bytes are already 8 bpp */
+		STORE_MONO(curr[x])
+		STORE_MONO(curr[x + 1])
+		STORE_MONO(curr[x + 2])
+		STORE_MONO(curr[x + 3])
+		/* Skip 5th src byte with 4 x 2 least-significant-bits */
+	}
+}
